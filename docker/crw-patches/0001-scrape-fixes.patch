+        domain_selectors: None,
+        captured_responses: captured,
+        llm_fallback: None,
+        debug: false,
+        debug_sink: None,
+        normalize_tables: false,
+    })
+    .unwrap()
+}
+
+/// What a consent manager loads over XHR: long strings of CSS, a signed token
+/// and a base64 HTML template. Before the fix these won the candidate ladder.
+fn consent_xhr() -> Vec<CapturedNetworkResponse> {
+    let css = "#onetrust-banner-sdk .ot-sdk-container { width: 100%; padding: 0; } \
+               #onetrust-policy-text { font-size: 16px; line-height: 1.5; color: #414C58; } "
+        .repeat(20);
+    let jwt = format!(
+        "eyJhbGciOiJSUzUxMiJ9.{}.{}",
+        "eyJvdEp3dFZlcnNpb24iOjF9".repeat(10),
+        "c2lnbmF0dXJl".repeat(8)
+    );
+    let b64 = "PGRpdiBjbGFzcz0ib3QtYmFubmVyIj48cD5XZSB1c2UgY29va2llczwvcD48L2Rpdj4=".repeat(12);
+    let body = serde_json::json!({ "css": css, "token": jwt, "html": b64 }).to_string();
+    vec![CapturedNetworkResponse {
+        url: "https://cdn.cookielaw.example/consent/banner.json".into(),
+        request_id: "1".into(),
+        status: 200,
+        mime_type: Some("application/json".into()),
+        body_size_bytes: body.len(),
+        body: Some(body),
+    }]
+}
+
+#[test]
+fn a_short_include_tags_result_is_not_swapped_for_other_content() {
+    let data = extract(
+        &["[data-cmp='inventoryListing'] [data-cmp='firstPrice']"],
+        true,
+        &[OutputFormat::Markdown],
+        &consent_xhr(),
+    );
+    let md = data.markdown.unwrap();
+    assert!(md.contains("33,293") && md.contains("34,949"), "got: {md}");
+    assert_no_machinery(&md);
+    assert!(!md.contains("onetrust"), "consent XHR leaked: {md}");
+    // No title or description padding around an explicit selection.
+    assert!(!md.contains("Vans for sale"), "got: {md}");
+    let counts = data
+        .metadata
+        .extra
+        .get("includeTagsMatches")
+        .expect("match counts in metadata");
+    assert_eq!(
+        counts,
+        &serde_json::json!({ "[data-cmp='inventoryListing'] [data-cmp='firstPrice']": 2 })
+    );
+}
+
+#[test]
+fn zero_include_matches_give_empty_content_and_a_warning_end_to_end() {
+    let data = extract(
+        &[".nothing-here"],
+        true,
+        &[OutputFormat::Markdown],
+        &consent_xhr(),
+    );
+    assert_eq!(data.markdown.as_deref().map(str::trim), Some(""));
+    assert!(
+        data.warnings.iter().any(|w| w == "selector_no_match"),
+        "{:?}",
+        data.warnings
+    );
+    assert!(
+        data.warnings
+            .iter()
+            .any(|w| w.contains("includeTags matched 0 elements")),
+        "{:?}",
+        data.warnings
+    );
+    assert_eq!(
+        data.metadata.extra.get("includeTagsMatches"),
+        Some(&serde_json::json!({ ".nothing-here": 0 }))
+    );
+}
+
+#[test]
+fn consent_xhr_never_reaches_markdown_html_or_text() {
+    // A page with almost no text forces the alternates ladder, where the XHR
+    // candidate used to win with the banner's CSS and tokens.
+    let formats = [
+        OutputFormat::Markdown,
+        OutputFormat::Html,
+        OutputFormat::PlainText,
+    ];
+    for only_main_content in [true, false] {
+        let data = extract(&[], only_main_content, &formats, &consent_xhr());
+        for out in [
+            data.markdown.unwrap_or_default(),
+            data.html.unwrap_or_default(),
+            data.plain_text.unwrap_or_default(),
+        ] {
+            assert_no_machinery(&out);
+            assert!(
+                !out.contains("ot-sdk-container"),
+                "consent CSS leaked: {out}"
+            );
+            assert!(!out.contains("eyJvdEp3"), "token leaked: {out}");
+        }
+    }
+}
