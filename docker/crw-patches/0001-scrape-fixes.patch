+/// How much of a failed body to keep for [`describe_body`].
+const BODY_HINT_BYTES: usize = 4096;
+
+/// Say what a body that should have been a PDF actually was: the status, the
+/// declared Content-Type, the size, and the HTML `<title>` or the first ~200
+/// characters. A login wall, a bot challenge or an error page served with a
+/// PDF Content-Type (or a `.pdf` URL) then reads differently from a damaged file.
+fn describe_body(head: &[u8], total_len: usize, status: u16, content_type: Option<&str>) -> String {
+    let content_type = content_type.unwrap_or("not given");
+    let mut out = format!("HTTP {status}, Content-Type: {content_type}, {total_len} bytes");
+    let text = String::from_utf8_lossy(head);
+    if let Some(title) = html_title(&text) {
+        out.push_str(&format!("; looks like an HTML page titled {title:?}"));
+    } else {
+        let start: String = text
+            .chars()
+            .take(200)
+            .map(|c| if c.is_control() { ' ' } else { c })
+            .collect();
+        let start = start.split_whitespace().collect::<Vec<_>>().join(" ");
+        out.push_str(&format!("; starts with {start:?}"));
+    }
+    out
+}
+
+/// The text of the first `<title>` element, if the text looks like HTML.
+fn html_title(text: &str) -> Option<String> {
+    let lower = text.to_ascii_lowercase();
+    let open = lower.find("<title")?;
+    let content_start = open + lower[open..].find('>')? + 1;
+    let content_end = content_start + lower[content_start..].find("</title")?;
+    let title = text[content_start..content_end]
+        .split_whitespace()
+        .collect::<Vec<_>>()
+        .join(" ");
+    (!title.is_empty()).then(|| title.chars().take(200).collect())
+}
