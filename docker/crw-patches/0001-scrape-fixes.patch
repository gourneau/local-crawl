+/// Below this many characters of extracted text a 2xx page counts as empty:
+/// it gets one more renderer and an `empty_content` warning. Deliberately well
+/// under the escalation thresholds above: a real page can be a single short
+/// heading ("Pro plan costs 99 USD"), and that is an answer, not a failure.
+const EMPTY_CONTENT_CHARS: usize = 20;
+
+/// The renderers a fetch went through, in order, for the `empty_content`
+/// warning: the failover chain when there was one, else the tier that served it.
+fn renderers_tried(fetch_result: &FetchResult) -> Vec<String> {
+    use crw_core::types::RenderDecision;
+    match &fetch_result.render_decision {
+        Some(RenderDecision::Failover { chain, .. }) => {
+            chain.iter().map(|k| k.as_str().to_string()).collect()
+        }
+        _ => fetch_result.rendered_with.iter().cloned().collect(),
+    }
+}
