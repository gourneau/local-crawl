+//! `includeTags` / `excludeTags` take any standard CSS selector, match against
+//! the whole rendered document, report what they matched, and never let page
+//! machinery (style sheets, scripts, templates, consent-banner JSON) into the
+//! output.
+
+use crw_core::types::{CapturedNetworkResponse, OutputFormat};
+use crw_extract::ExtractOptions;
+use crw_extract::clean::{SelectorReport, clean_html_with_report};
+
+/// A listing page shaped like the ones that broke: cards with data attributes,
+/// a price nested two levels down, a cookie banner with an inline style sheet,
+/// a client-side template and a JSON blob in a script.
+const LISTING: &str = r#"<!doctype html><html><head><title>Vans for sale - Example</title>
+<style>#onetrust-banner-sdk { border-radius: 8px; }</style></head><body>
+<header class="site-header"><div class="promo-strip" data-cmp="deal">Header deal $1</div></header>
+<div id="onetrust-consent-sdk"><style id="onetrust-style">#onetrust-banner-sdk .x{color:red;}</style>
+  <div id="onetrust-banner-sdk"><p>We use cookies to improve your experience.</p></div></div>
+<main>
+  <div data-cmp="inventoryListing" class="card">
+    <h2 data-cmp="title">2024 Van A</h2>
+    <div data-cmp="pricing"><span class="price" data-cmp="firstPrice">33,293</span></div>
+    <div class="ad-slot">Sponsored</div>
+  </div>
+  <div data-cmp="inventoryListing" class="card featured">
+    <h2 data-cmp="title">2024 Van B</h2>
+    <div data-cmp="pricing"><span class="price" data-cmp="firstPrice">34,949</span></div>
+  </div>
+  <aside class="card promo" data-cmp="inventorySponsored">
+    <div data-cmp="pricing"><span class="price" data-cmp="firstPrice">29,999</span></div>
+  </aside>
+</main>
+<template id="card-tpl"><div class="card">{{title}} {{price}}</div></template>
+<script type="text/template"><div>PGRpdj5iYXNlNjQgdGVtcGxhdGU8L2Rpdj4=</div></script>
+<script type="application/json">{"token":"eyJhbGciOiJSUzUxMiJ9.eyJzdWIiOiJ4In0.c2ln"}</script>
+<noscript>Please enable JavaScript</noscript>
+</body></html>"#;
+
+fn tags(list: &[&str]) -> Vec<String> {
+    list.iter().map(|s| s.to_string()).collect()
+}
+
+fn clean(
+    only_main_content: bool,
+    include: &[&str],
+    exclude: &[&str],
+) -> (String, Vec<String>, SelectorReport) {
+    let mut warnings = Vec::new();
+    let mut report = SelectorReport::default();
+    let out = clean_html_with_report(
+        LISTING,
+        only_main_content,
+        &tags(include),
+        &tags(exclude),
+        &mut warnings,
+        &mut report,
+    )
+    .unwrap();
+    (out, warnings, report)
+}
+
+fn assert_no_machinery(out: &str) {
+    for leak in [
+        "border-radius",
+        "color:red",
+        "{{title}}",
+        "PGRpdj5i",
+        "eyJhbGci",
+        "Please enable JavaScript",
+    ] {
+        assert!(!out.contains(leak), "leaked {leak:?} into: {out}");
+    }
+}
+
+// ── item 1: full CSS selectors ───────────────────────────────────────────────
+
+#[test]
+fn descendant_attribute_selector_matches() {
+    let (out, warnings, _) = clean(
+        true,
+        &[r#"[data-cmp="inventoryListing"] [data-cmp="firstPrice"]"#],
+        &[],
+    );
+    assert!(
+        out.contains("33,293") && out.contains("34,949"),
+        "got: {out}"
+    );
+    assert!(
+        !out.contains("Van A"),
+        "only the prices were selected: {out}"
+    );
+    assert!(warnings.is_empty(), "{warnings:?}");
+}
+
+#[test]
+fn prefix_attribute_descendant_selector_matches() {
+    // The exact shape from the bug report: "[data-a^='x'] [data-b='y']".
+    let (out, _, _) = clean(
+        true,
+        &["[data-cmp^='inventory'] [data-cmp='firstPrice']"],
+        &[],
+    );
+    assert!(
+        out.contains("33,293") && out.contains("34,949") && out.contains("29,999"),
+        "got: {out}"
+    );
+}
+
+#[test]
+fn child_combinator_with_classes_matches() {
+    let (out, _, _) = clean(true, &["div.card > h2"], &[]);
+    assert!(
+        out.contains("2024 Van A") && out.contains("2024 Van B"),
+        "got: {out}"
+    );
+    assert!(
+        !out.contains("33,293"),
+        "child combinator must not reach grandchildren: {out}"
+    );
+}
+
+#[test]
+fn suffix_contains_and_not_selectors_match() {
+    let (out, _, report) = clean(
+        true,
+        &[
+            "[data-cmp$='Listing'] [data-cmp*='Price']",
+            ".card:not(.featured) > [data-cmp='title']",
+        ],
+        &[],
+    );
+    assert!(out.contains("33,293"), "got: {out}");
+    assert!(out.contains("2024 Van A"), "got: {out}");
+    assert!(
+        !out.contains("2024 Van B"),
+        ":not(.featured) must exclude Van B: {out}"
+    );
+    assert_eq!(report.include_matches[0].1, 2);
+    assert_eq!(report.include_matches[1].1, 1);
+}
+
+#[test]
+fn comma_list_is_one_selector_and_keeps_document_order() {
+    let (out, _, report) = clean(false, &["[data-cmp='firstPrice'], [data-cmp='title']"], &[]);
+    let a = out.find("2024 Van A").unwrap();
+    let pa = out.find("33,293").unwrap();
+    let b = out.find("2024 Van B").unwrap();
+    assert!(a < pa && pa < b, "expected document order, got: {out}");
+    assert_eq!(
+        report.include_matches,
+        vec![("[data-cmp='firstPrice'], [data-cmp='title']".to_string(), 5)]
+    );
+}
+
+#[test]
+fn nested_matches_are_not_emitted_twice() {
+    let (out, _, _) = clean(
+        false,
+        &["[data-cmp='inventoryListing']", "[data-cmp='firstPrice']"],
+        &[],
+    );
+    assert_eq!(out.matches("33,293").count(), 1, "got: {out}");
+    // The aside's price is only matched by the second selector, so it appears once too.
+    assert_eq!(out.matches("29,999").count(), 1, "got: {out}");
+}
+
+#[test]
+fn selectors_see_elements_the_boilerplate_rules_would_remove() {
+    // With onlyMainContent the cleaner drops <header>, <aside> and `.promo`.
+    // A selector naming something inside them must still match: selection runs
+    // on the full document first, and a selected element is never removed.
+    let (out, warnings, _) = clean(true, &["header [data-cmp='deal']", "aside.promo"], &[]);
+    assert!(out.contains("Header deal $1"), "got: {out}");
+    assert!(out.contains("29,999"), "got: {out}");
+    assert!(warnings.is_empty(), "{warnings:?}");
+}
+
+#[test]
+fn boilerplate_inside_a_selection_is_still_cleaned() {
+    let (out, _, _) = clean(true, &["[data-cmp='inventoryListing']"], &[]);
+    assert!(out.contains("33,293"), "got: {out}");
+    assert!(
+        !out.contains("Sponsored"),
+        "the ad slot inside the card is still noise: {out}"
+    );
+}
+
+#[test]
+fn exclude_tags_take_descendant_selectors_across_the_selection() {
+    let (out, _, _) = clean(
+        false,
+        &["[data-cmp='inventoryListing']"],
+        &["main .featured [data-cmp='pricing']"],
+    );
+    assert!(out.contains("33,293"), "got: {out}");
+    assert!(out.contains("2024 Van B"), "got: {out}");
+    assert!(!out.contains("34,949"), "excluded price leaked: {out}");
+}
+
+#[test]
+fn selector_strings_are_not_split_on_spaces_or_commas() {
+    let (_, _, report) = clean(false, &["main  div.card , aside.promo"], &[]);
+    assert_eq!(report.include_matches.len(), 1);
+    assert_eq!(report.include_matches[0].0, "main  div.card , aside.promo");
+    assert_eq!(report.include_matches[0].1, 3);
+}
+
+// ── item 2: zero matches fail clearly ────────────────────────────────────────
+
+#[test]
+fn zero_matches_return_empty_and_say_so() {
+    let (out, warnings, report) = clean(true, &[".does-not-exist", "#nope"], &[]);
+    assert!(out.is_empty(), "must not fall back to other content: {out}");
+    assert!(
+        warnings.iter().any(|w| w == "selector_no_match"),
+        "{warnings:?}"
+    );
+    assert!(
+        warnings
+            .iter()
+            .any(|w| w.starts_with("include_tags_no_match: includeTags matched 0 elements")),
+        "{warnings:?}"
+    );
+    assert_eq!(
+        report.include_matches,
+        vec![(".does-not-exist".to_string(), 0), ("#nope".to_string(), 0)]
+    );
+}
+
+#[test]
+fn a_selector_that_matched_nothing_beside_one_that_did_is_reported() {
+    let (out, warnings, _) = clean(true, &["[data-cmp='firstPrice']", ".missing"], &[]);
+    assert!(out.contains("33,293"));
+    assert!(
+        warnings.iter().any(
+            |w| w == r#"include_tags_partial_match: includeTags ".missing" matched 0 elements"#
+        ),
+        "{warnings:?}"
+    );
+}
+
+#[test]
+fn invalid_selectors_are_reported_not_ignored() {
+    let (out, warnings, report) = clean(true, &["div[[", "[data-cmp='title']"], &["!!"]);
+    assert!(out.contains("2024 Van A"));
+    assert!(
+        warnings
+            .iter()
+            .any(|w| w == r#"invalid_selector: includeTags "div[[" is not valid CSS"#),
+        "{warnings:?}"
+    );
+    assert!(
+        warnings
+            .iter()
+            .any(|w| w == r#"invalid_selector: excludeTags "!!" is not valid CSS"#),
+        "{warnings:?}"
+    );
+    assert_eq!(
+        report.include_matches,
+        vec![("[data-cmp='title']".to_string(), 2)]
+    );
+}
+
+#[test]
+fn everything_matched_but_excluded_is_a_clear_no_match() {
+    let (out, warnings, _) = clean(false, &["[data-cmp='firstPrice']"], &["main"]);
+    assert!(out.is_empty(), "got: {out}");
+    assert!(
+        warnings
+            .iter()
+            .any(|w| w.contains("removed by excludeTags")),
+        "{warnings:?}"
+    );
+}
+
+// ── item 3: no style / script / template text, in any mode ──────────────────
+
+#[test]
+fn machinery_never_survives_cleaning() {
+    for only_main_content in [true, false] {
+        let (out, _, _) = clean(only_main_content, &[], &[]);
+        assert_no_machinery(&out);
+        assert!(out.contains("33,293"));
+        let (out, _, _) = clean(only_main_content, &["body"], &[]);
+        assert_no_machinery(&out);
+        let (out, _, _) = clean(only_main_content, &["template", "noscript", "style"], &[]);
+        assert_no_machinery(&out);
+    }
+}
+
+#[test]
+fn consent_banners_are_removed_by_default_and_kept_on_request() {
+    let (out, _, _) = clean(true, &[], &[]);
+    assert!(!out.contains("We use cookies"), "got: {out}");
+    // onlyMainContent: false keeps the page as it is, banner included.
+    let (out, _, _) = clean(false, &[], &[]);
+    assert!(out.contains("We use cookies"), "got: {out}");
+}
+
+#[test]
+fn consent_managers_without_cookie_or_consent_in_their_names_are_removed() {
+    for container in [
+        r#"<div class="osano-cm-window"><div class="osano-cm-dialog">BANNER</div></div>"#,
+        r#"<div id="qc-cmp2-container">BANNER</div>"#,
+        r#"<div id="didomi-host">BANNER</div>"#,
+        r#"<div id="usercentrics-root">BANNER</div>"#,
+        r#"<div id="sp_message_container_123456">BANNER</div>"#,
+        r#"<div id="iubenda-cs-banner">BANNER</div>"#,
+    ] {
+        let html = format!("<body>{container}<main><p>The article.</p></main></body>");
+        let out = crw_extract::clean::clean_html(&html, true, &[], &[]).unwrap();
+        assert!(!out.contains("BANNER"), "{container} survived: {out}");
+        assert!(out.contains("The article."), "{out}");
