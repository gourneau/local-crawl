@@ -0,0 +1,121 @@
+//! A 2xx page with no extractable text is reported, not returned as a silent
+//! empty success. Offline: the origin is a wiremock server and the renderer is
+//! HTTP-only, so there is no next tier to retry with.
+
+use std::sync::Arc;
+
+use crw_core::config::{ExtractionConfig, RendererConfig, StealthConfig};
+use crw_core::types::{OutputFormat, ScrapeRequest};
+use crw_crawl::single::scrape_url;
+use crw_renderer::FallbackRenderer;
+use wiremock::matchers::{method, path};
+use wiremock::{Mock, MockServer, ResponseTemplate};
+
+const UA: &str = "crw-test/0.0";
+
+async fn page_server(body: &str) -> (MockServer, String) {
+    let server = MockServer::start().await;
+    Mock::given(method("GET"))
+        .and(path("/page"))
+        .respond_with(
+            // set_body_raw, not set_body_string: the latter forces text/plain,
+            // and crw (correctly) does not run a plain-text body through HTML.
+            ResponseTemplate::new(200)
+                .set_body_raw(body.as_bytes().to_vec(), "text/html; charset=utf-8"),
+        )
+        .mount(&server)
+        .await;
+    let url = format!("{}/page", server.uri());
+    (server, url)
+}
+
+async fn scrape(req: &ScrapeRequest) -> crw_core::types::ScrapeData {
+    let renderer = Arc::new(
+        FallbackRenderer::new(
+            &RendererConfig::default(),
+            UA,
+            None,
+            &StealthConfig::default(),
+        )
+        .expect("renderer"),
+    );
+    scrape_url(
+        req,
+        &renderer,
+        None,
+        &ExtractionConfig::default(),
+        UA,
+        false,
+        Some(false),
+        crw_core::deadline::Deadline::from_request_ms(30_000),
+    )
+    .await
+    .expect("scrape")
+}
+
+fn markdown_request(url: &str) -> ScrapeRequest {
+    ScrapeRequest {
+        url: url.to_string(),
+        formats: vec![OutputFormat::Markdown],
+        ..Default::default()
+    }
+}
+
+#[tokio::test]
+async fn an_empty_200_page_gets_an_empty_content_warning() {
+    // What a soft block or an unfinished render looks like: a 200 whose body
+    // is only page machinery.
+    let (_server, url) = page_server(
+        "<html><head><title>x</title><script>window.__APP__={}</script></head>\
+         <body><div id=\"root\"></div><style>#root{min-height:100vh}</style></body></html>",
+    )
+    .await;
+    let data = scrape(&markdown_request(&url)).await;
+    let warning = data
+        .warnings
+        .iter()
+        .find(|w| w.starts_with("empty_content:"))
+        .unwrap_or_else(|| panic!("expected an empty_content warning, got {:?}", data.warnings));
+    assert!(warning.contains("HTTP 200"), "{warning}");
+    assert!(warning.contains("renderers tried: http"), "{warning}");
+}
+
+#[tokio::test]
+async fn a_short_real_page_is_not_called_empty() {
+    let (_server, url) =
+        page_server("<html><body><h1>Pro plan costs 99 USD</h1></body></html>").await;
+    let data = scrape(&markdown_request(&url)).await;
+    assert!(
+        !data
+            .warnings
+            .iter()
+            .any(|w| w.starts_with("empty_content:")),
+        "{:?}",
+        data.warnings
+    );
+}
+
+#[tokio::test]
+async fn an_empty_selection_is_not_reported_as_an_empty_page() {
+    // includeTags that matched nothing has its own warning; the page itself is fine.
+    let (_server, url) = page_server(
+        "<html><body><article><p>Plenty of real text here.</p></article></body></html>",
+    )
+    .await;
+    let mut req = markdown_request(&url);
+    req.include_tags = vec![".not-on-this-page".into()];
+    let data = scrape(&req).await;
+    assert!(
+        data.warnings.iter().any(|w| w == "selector_no_match"),
+        "{:?}",
+        data.warnings
+    );
+    assert!(
+        !data
+            .warnings
+            .iter()
+            .any(|w| w.starts_with("empty_content:")),
+        "{:?}",
+        data.warnings
+    );
+}
